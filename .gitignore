# Machine-specific config — holds IPs, passwords, and install paths.
# Copy config.example.json to config.json and edit it.
config.json

# SQLite database (event log, schedules, settings, Discord bot token).
# Leading slash matters: a bare "db/" matches at any depth and would also
# exclude src/db/, which is source code.
/db/
*.db
*.db-shm
*.db-wal

# Dependencies
node_modules/

# Logs
logs/
*.log

# OS / editor cruft
Thumbs.db
.DS_Store
.vscode/
.idea/
